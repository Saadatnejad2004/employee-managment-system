# Copy these into your shell (Django does not read .env files by itself).
#   Mac/Linux:   export DJANGO_DEBUG=1
#   PowerShell:  $env:DJANGO_DEBUG = "1"
#
# Local development
DJANGO_DEBUG=1

# Production (DEBUG off): a long random key is REQUIRED.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=ems.example.com
