# Copy to .env  (cp .env.example .env). Django reads it automatically; it is git-ignored.
# Real environment variables always take precedence over this file.

# --- Local development (SQLite, no Docker) ---
DJANGO_DEBUG=1

# --- Docker Compose / production ---
# Required when DJANGO_DEBUG is off. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=ems.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://ems.example.com
# DJANGO_HTTPS=1                 # redirect to https, secure cookies, HSTS
# DJANGO_BEHIND_PROXY=1          # trust X-Forwarded-Proto from your reverse proxy
# POSTGRES_PASSWORD=change-me    # (docker compose only)

# Optional first-run admin account created by the container on start:
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=
# DJANGO_SUPERUSER_EMAIL=admin@example.com

# Point your host-side `manage.py` at the compose database instead of SQLite:
# DATABASE_URL=postgres://ems:ems@localhost:5432/ems
